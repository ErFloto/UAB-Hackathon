# Copia aquest fitxer a .env i omple els valors NOMÉS al teu dispositiu.
# Mai facis commit del .env.

# Mode de la demo: mock (sense xarxa) o api (backend real)
ESCOLTA_MODE=api

# Typeform (comparteix el token només dins de l'equip)
