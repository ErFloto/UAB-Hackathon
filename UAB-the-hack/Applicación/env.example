# Copia aquest fitxer a ".env" (a la carpeta Applicación) i omple els valors NOMÉS al teu dispositiu.
# Mai facis commit del .env.

# Mode de la IA: "mock" (sense xarxa, tot funciona) o "api" (passarel·la d'IA)
ESCOLTA_MODE=mock

# Passarel·la d'IA compatible amb OpenAI (només amb ESCOLTA_MODE=api)
ESCOLTA_API_URL=
ESCOLTA_API_KEY=

# Llindar de privacitat: % de la població de cada col·lectiu (1-10). Mai per sota de 8 respostes.
PRIVACY_THRESHOLD_PCT=4

# URL on s'obre el QR/enllaç. Per provar des del mòbil: IP local, p. ex. http://192.168.1.35:8501
PUBLIC_URL=

# PIN del panell de RRHH (només números). Si queda buit, el panell queda bloquejat.
ADMIN_PIN=

# Opcional: webhook de Teams (Workflows). Si queda buit, la integració va en mode simulat.
TEAMS_WEBHOOK_URL=

# Opcional
# PII_TIMEOUT_S=10
# HASH_SALT=
